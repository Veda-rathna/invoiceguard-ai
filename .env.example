# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# AI Configuration (Amazon Bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=qwen.qwen3-vl-235b-a22b
# AWS Credentials are automatically resolved via AWS CLI, IAM Role, or profile.
# Optionally, you can specify them here for local testing:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Offline / Hackathon Demo Mode (Set to true to use rich mock document intelligence when Bedrock keys are not active)
DEMO_MODE=true

# Database (PostgreSQL URL, falls back to SQLite automatically if PostgreSQL is unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoiceguard
# SQLite fallback: sqlite:///./invoiceguard.db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# Default Policy Engine Thresholds (Configurable in UI)
AUTO_APPROVAL_LIMIT=50000.0
PO_REQUIRED_ABOVE=10000.0
MAXIMUM_PO_VARIANCE_PERCENT=5.0
NEW_VENDOR_REQUIRES_REVIEW=true
DUPLICATE_SIMILARITY_THRESHOLD=90.0
MINIMUM_EXTRACTION_CONFIDENCE=75.0
RECEIPT_REQUIRED_ABOVE=2000.0
